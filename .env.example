# ====================================================================
# HouseHelper Environment Configuration Template
# Copy this file to '.env.local' and populate with your credentials.
# NEVER commit '.env.local' or production credentials to source control.
# ====================================================================

# Firebase Client Configuration (Firebase Web App Settings)
REACT_APP_FIREBASE_API_KEY=AIzaSy_your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789012
REACT_APP_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
REACT_APP_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Application Integrity & Environment Mode
REACT_APP_ENV=development

# Optional Firebase App Check (public site key only — keep reCAPTCHA secret exclusively in Firebase Console)
# Use REACT_APP_RECAPTCHA_V3_SITE_KEY (classic reCAPTCHA v3, compatible with Spark plan)
# or REACT_APP_RECAPTCHA_ENTERPRISE_SITE_KEY (reCAPTCHA Enterprise).
REACT_APP_RECAPTCHA_V3_SITE_KEY=
REACT_APP_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local development only (never set in Production): "true" or a registered debug token UUID
REACT_APP_APPCHECK_DEBUG_TOKEN=
