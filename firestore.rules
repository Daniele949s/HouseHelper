rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // GLOBAL SECURITY & MULTI-TENANT HELPERS
    // ==========================================

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Safely retrieve user document from Firestore
    function getUserDoc() {
      return get(/databases/$(database)/documents/utenti/$(request.auth.uid));
    }

    // Verify user profile exists and has an active non-empty casaId
    function hasValidCasa() {
      return isSignedIn() 
        && exists(/databases/$(database)/documents/utenti/$(request.auth.uid))
        && getUserDoc().data.casaId != null
        && getUserDoc().data.casaId is string
        && getUserDoc().data.casaId.size() > 0;
    }

    // Retrieve user's active household ID
    function getUserCasaId() {
      return getUserDoc().data.casaId;
    }

    // Strict allowlist for active membership:
    // Allows 'active' and legacy profiles where 'statoMembro' key is absent.
    // Explicitly denies 'pending', null, and any unexpected value.
    function isActiveMember() {
      return !('statoMembro' in getUserDoc().data)
        || getUserDoc().data.statoMembro == 'active';
    }

    // Strict multi-tenant household barrier: prevents null == null exploit
    // and blocks pending, null, or unexpected member states from accessing household data.
    function belongsToSameHouse(casaId) {
      return hasValidCasa() 
        && casaId != null 
        && casaId is string 
        && casaId.size() > 0 
        && getUserCasaId() == casaId
        && isActiveMember();
    }

    function housePath(casaId) {
      return /databases/$(database)/documents/case/$(casaId);
    }

    function isHouseAdmin(casaId) {
      return isSignedIn() && casaId is string && casaId.size() > 0
        && get(housePath(casaId)).data.get(
          'adminUid', get(housePath(casaId)).data.get('creatoreId', null)
        ) == request.auth.uid;
    }

    function isHouseMembershipUpdate(userId) {
      let before = resource.data;
      let after = request.resource.data;
      let casaId = before.casaId;
      let changed = after.diff(before).affectedKeys();
      return isHouseAdmin(casaId) && (
        (userId != request.auth.uid && (
          (before.get('statoMembro', null) == 'pending'
            && changed.hasOnly(['statoMembro', 'ruoloCasa'])
            && after.statoMembro == 'active' && after.ruoloCasa == 'member')
          || (changed.hasOnly(['casaId', 'ruoloCasa', 'statoMembro'])
            && after.casaId == null && after.ruoloCasa == null && after.statoMembro == null)
          || (changed.hasOnly(['statoMembro', 'ruoloCasa'])
            && after.ruoloCasa == 'admin' && after.statoMembro == 'active'
            && getAfter(housePath(casaId)).data.adminUid == userId)
        ))
        || (userId == request.auth.uid && changed.hasOnly(['ruoloCasa'])
          && after.ruoloCasa == 'member'
          && getAfter(housePath(casaId)).data.adminUid != userId)
      );
    }

    function isOwnerMembershipUpdate() {
      let after = request.resource.data;
      return !after.diff(resource.data).affectedKeys().hasAny(['casaId', 'ruoloCasa', 'statoMembro'])
        || (after.casaId == null && after.get('ruoloCasa', null) == null
          && after.get('statoMembro', null) == null)
        || (resource.data.get('casaId', null) == null
          && after.casaId is string && after.casaId.size() > 0
          && exists(housePath(after.casaId)) && (
            (after.get('ruoloCasa', null) == 'member' && after.get('statoMembro', null) == 'pending')
            || (after.get('ruoloCasa', null) == 'admin' && after.get('statoMembro', null) == 'active'
              && isHouseAdmin(after.casaId))
          ));
    }

    function isAdminTransfer(casaId) {
      let uid = request.resource.data.get('adminUid', '');
      let target = /databases/$(database)/documents/utenti/$(uid);
      let previous = /databases/$(database)/documents/utenti/$(request.auth.uid);
      return uid is string && uid.size() > 0 && uid != request.auth.uid
        && request.resource.data.creatoreId == uid
        && get(target).data.casaId == casaId
        && getAfter(target).data.casaId == casaId
        && getAfter(target).data.ruoloCasa == 'admin'
        && getAfter(target).data.statoMembro == 'active'
        && getAfter(previous).data.ruoloCasa == 'member';
    }

    // Helper: Validates that the authenticated user has verified their email or signed in via trusted provider (e.g. Google)
    function isEmailVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true || 
        request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }

    // Helper: Validates positive importo between 0.01 and 50,000.00 EUR (supports string and number)
    function isValidImporto(val) {
      return (val is number && val > 0.0 && val <= 50000.0)
          || (val is string && val.size() > 0 && float(val) > 0.0 && float(val) <= 50000.0);
    }

    // Helper: Non-empty string with maximum length bound
    function isNonEmptyString(val, maxLen) {
      return val is string && val.trim().size() > 0 && val.size() <= maxLen;
    }

    // Helper: Valid YYYY-MM-DD date string (length 10)
    function isValidDateString(val) {
      return val is string && val.size() == 10;
    }

    // ==========================================
    // 1. UTENTI (User Profiles)
    // ==========================================
    match /utenti/{userId} {
      // Allow reading user profile if self OR if belonging to the same household
      allow read: if isSignedIn() && (
        isOwner(userId) || 
        (resource.data.casaId != null && belongsToSameHouse(resource.data.casaId))
      );

      // Create profile: only the account owner, required username and email
      allow create: if isOwner(userId)
        && isNonEmptyString(request.resource.data.username, 50)
        && isNonEmptyString(request.resource.data.email, 100)
        && request.resource.data.casaId == null
        && request.resource.data.get('ruoloCasa', null) == null
        && request.resource.data.get('statoMembro', null) == null;

      // Owners edit their profiles. Household admins can change membership fields.
      allow update: if (isOwner(userId) && isOwnerMembershipUpdate()
        && isNonEmptyString(request.resource.data.username, 50)
        && (request.resource.data.casaId == null || (request.resource.data.casaId is string && request.resource.data.casaId.size() <= 64))
        && (!('inVacanza' in request.resource.data) || request.resource.data.inVacanza is bool)
        && (!('vacanzaInizio' in request.resource.data) || request.resource.data.vacanzaInizio == null || isValidDateString(request.resource.data.vacanzaInizio))
        && (!('vacanzaFine' in request.resource.data) || request.resource.data.vacanzaFine == null || isValidDateString(request.resource.data.vacanzaFine)))
        || isHouseMembershipUpdate(userId);

      // Profiles are never deleted directly by clients
      allow delete: if false;
    }

    // ==========================================
    // 2. CASE (Nuclei Abitativi)
    // ==========================================
    match /case/{casaId} {
      // Get: Active members and pending members awaiting approval for THEIR house only.
      // Unassigned users must resolve invite codes via /inviti/{codice} instead of reading /case.
      allow get: if isSignedIn() && (
        belongsToSameHouse(casaId)
        || (hasValidCasa() && getUserCasaId() == casaId)
      );

      // List: Active members of the house. Transitional fallback (limit <= 1) preserved for
      // unassigned users while legacy houses created before /inviti/{codice} are backfilled.
      allow list: if isSignedIn() && (
        belongsToSameHouse(casaId)
        || (!hasValidCasa() && request.query.limit <= 1)
      );

      // Create: Authenticated users can create a new household with required fields
      allow create: if isSignedIn()
        && isNonEmptyString(request.resource.data.nome, 60)
        && isNonEmptyString(request.resource.data.codiceUnivoco, 12)
        && request.resource.data.codiceUnivoco.size() >= 4
        && request.resource.data.creatoreId == request.auth.uid
        && request.resource.data.get('adminUid', request.auth.uid) == request.auth.uid;

      allow update: if isNonEmptyString(request.resource.data.nome, 60)
        && (!('impostazioniTurni' in request.resource.data) || request.resource.data.impostazioniTurni is map)
        && (
          ((isHouseAdmin(casaId) || (belongsToSameHouse(casaId)
            && getUserDoc().data.get('statoMembro', 'active') == 'active'))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'impostazioniTurni']))
          || (isHouseAdmin(casaId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminUid', 'creatoreId', 'nome', 'impostazioniTurni'])
            && isAdminTransfer(casaId))
        );

      allow delete: if isHouseAdmin(casaId);
    }

    // ==========================================
    // 2B. INVITI (Exact-Code Invite Lookup, Zero Enumeration)
    // ==========================================
    match /inviti/{codice} {
      // Proves exact possession of the invite code; listing all invites is strictly denied.
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && isNonEmptyString(codice, 12)
        && codice.size() >= 4
        && isNonEmptyString(request.resource.data.casaId, 64)
        && isNonEmptyString(request.resource.data.nomeCasa, 60)
        && request.resource.data.creatoreId == request.auth.uid
        && isHouseAdmin(request.resource.data.casaId);

      allow update: if false;
      allow delete: if isSignedIn() && isHouseAdmin(resource.data.casaId);
    }

    // ==========================================
    // 3. TURNI (Cleaning Shifts)
    // ==========================================
    match /turni/{turnoId} {
      allow read: if belongsToSameHouse(resource.data.casaId);

      allow create: if belongsToSameHouse(request.resource.data.casaId)
        && request.resource.data.utenteId == request.auth.uid
        && request.resource.data.nomi is list && request.resource.data.nomi.size() > 0 && request.resource.data.nomi.size() <= 15
        && request.resource.data.luoghi is list && request.resource.data.luoghi.size() > 0 && request.resource.data.luoghi.size() <= 15
        && isValidDateString(request.resource.data.data)
        && (!('checklist' in request.resource.data) || (request.resource.data.checklist is list && request.resource.data.checklist.size() <= 30))
        && (!('completato' in request.resource.data) || request.resource.data.completato is bool);

      allow update: if belongsToSameHouse(resource.data.casaId)
        && request.resource.data.casaId == resource.data.casaId
        && request.resource.data.nomi is list && request.resource.data.nomi.size() > 0 && request.resource.data.nomi.size() <= 15
        && request.resource.data.luoghi is list && request.resource.data.luoghi.size() > 0 && request.resource.data.luoghi.size() <= 15
        && isValidDateString(request.resource.data.data)
        && (!('checklist' in request.resource.data) || (request.resource.data.checklist is list && request.resource.data.checklist.size() <= 30))
        && (!('completato' in request.resource.data) || request.resource.data.completato is bool);

      allow delete: if belongsToSameHouse(resource.data.casaId);
    }

    // ==========================================
    // 4. DEBITI (Expenses & Debts)
    // ==========================================
    match /debiti/{debitoId} {
      allow read: if belongsToSameHouse(resource.data.casaId);

      // Create: Enforce positive amount <= 50,000 EUR, non-empty description, no self-debts,
      // active membership, and both creditor/debtor belonging to the same household.
      allow create: if belongsToSameHouse(request.resource.data.casaId)
        && isValidImporto(request.resource.data.importo)
        && isNonEmptyString(request.resource.data.descrizione, 255)
        && isNonEmptyString(request.resource.data.creditoreId, 64)
        && isNonEmptyString(request.resource.data.debitoreId, 64)
        && request.resource.data.creditoreId != request.resource.data.debitoreId
        && get(/databases/$(database)/documents/utenti/$(request.resource.data.creditoreId)).data.casaId == request.resource.data.casaId
        && get(/databases/$(database)/documents/utenti/$(request.resource.data.debitoreId)).data.casaId == request.resource.data.casaId;

      // Update: Only debtor, creditor, or house admin may modify/settle. Immutability on casaId, creditoreId, debitoreId.
      allow update: if belongsToSameHouse(resource.data.casaId)
        && (request.auth.uid == resource.data.debitoreId || request.auth.uid == resource.data.creditoreId || isHouseAdmin(resource.data.casaId))
        && request.resource.data.casaId == resource.data.casaId
        && request.resource.data.creditoreId == resource.data.creditoreId
        && request.resource.data.debitoreId == resource.data.debitoreId
        && isValidImporto(request.resource.data.importo)
        && isNonEmptyString(request.resource.data.descrizione, 255)
        && (!('saldato' in request.resource.data) || request.resource.data.saldato is bool);

      // The debtor, creditor, or house admin may delete the debt.
      allow delete: if belongsToSameHouse(resource.data.casaId)
        && (request.auth.uid == resource.data.debitoreId || request.auth.uid == resource.data.creditoreId || isHouseAdmin(resource.data.casaId));
    }

    // ==========================================
    // 5. SPESA (Grocery List)
    // ==========================================
    match /spesa/{spesaId} {
      allow read: if belongsToSameHouse(resource.data.casaId);

      allow create: if belongsToSameHouse(request.resource.data.casaId)
        && isNonEmptyString(request.resource.data.nome, 100)
        && request.resource.data.comprato is bool;

      allow update: if belongsToSameHouse(resource.data.casaId)
        && request.resource.data.casaId == resource.data.casaId
        && isNonEmptyString(request.resource.data.nome, 100)
        && request.resource.data.comprato is bool;

      allow delete: if belongsToSameHouse(resource.data.casaId);
    }

    // ==========================================
    // 6. NOTE & EVENTI (Bulletin Board & Calendar)
    // ==========================================
    match /note/{notaId} {
      allow read: if belongsToSameHouse(resource.data.casaId);

      allow create: if belongsToSameHouse(request.resource.data.casaId)
        && request.resource.data.autoreId == request.auth.uid
        && isNonEmptyString(request.resource.data.titolo, 100)
        && isNonEmptyString(request.resource.data.contenuto, 1500);

      // Update: Only original author or house admin may edit a notice (prevents author impersonation).
      allow update: if belongsToSameHouse(resource.data.casaId)
        && (request.auth.uid == resource.data.autoreId || isHouseAdmin(resource.data.casaId))
        && request.resource.data.casaId == resource.data.casaId
        && request.resource.data.autoreId == resource.data.autoreId
        && isNonEmptyString(request.resource.data.titolo, 100)
        && isNonEmptyString(request.resource.data.contenuto, 1500);

      allow delete: if belongsToSameHouse(resource.data.casaId)
        && (request.auth.uid == resource.data.autoreId || isHouseAdmin(resource.data.casaId));
    }

    // ==========================================
    // 7. DOCUMENTI (Milestone 6: Household Documents)
    // ==========================================
    match /documenti/{docId} {
      allow read: if belongsToSameHouse(resource.data.casaId);

      allow create: if belongsToSameHouse(request.resource.data.casaId)
        && request.resource.data.caricatoDa == request.auth.uid
        && isNonEmptyString(request.resource.data.nome, 120)
        && isNonEmptyString(request.resource.data.categoria, 50)
        && isNonEmptyString(request.resource.data.fileUrl, 1000)
        && request.resource.data.fileUrl.matches('^https://.*')
        && (!('url' in request.resource.data) || (request.resource.data.url is string && request.resource.data.url.matches('^https://.*')))
        && request.resource.data.dimensioneBytes is int
        && request.resource.data.dimensioneBytes > 0
        && request.resource.data.dimensioneBytes <= 26214400; // Max 25 MB

      allow update: if belongsToSameHouse(resource.data.casaId)
        && request.resource.data.casaId == resource.data.casaId
        && request.resource.data.caricatoDa == resource.data.caricatoDa
        && request.resource.data.fileUrl == resource.data.fileUrl
        && (!('url' in resource.data) || request.resource.data.url == resource.data.url)
        && isNonEmptyString(request.resource.data.nome, 120)
        && isNonEmptyString(request.resource.data.categoria, 50);

      allow delete: if belongsToSameHouse(resource.data.casaId);
    }

    // ==========================================
    // 8. CONTATTI (Milestone 7: Useful & Emergency Contacts)
    // ==========================================
    match /contatti/{contattoId} {
      allow read: if belongsToSameHouse(resource.data.casaId);

      allow create: if belongsToSameHouse(request.resource.data.casaId)
        && isNonEmptyString(request.resource.data.nome, 100)
        && isNonEmptyString(request.resource.data.categoria, 50)
        && (!('telefono' in request.resource.data) || request.resource.data.telefono == null || request.resource.data.telefono is string)
        && (!('email' in request.resource.data) || request.resource.data.email == null || request.resource.data.email is string)
        && (!('note' in request.resource.data) || request.resource.data.note == null || request.resource.data.note is string);

      allow update: if belongsToSameHouse(resource.data.casaId)
        && request.resource.data.casaId == resource.data.casaId
        && isNonEmptyString(request.resource.data.nome, 100)
        && isNonEmptyString(request.resource.data.categoria, 50)
        && (!('telefono' in request.resource.data) || request.resource.data.telefono == null || request.resource.data.telefono is string)
        && (!('email' in request.resource.data) || request.resource.data.email == null || request.resource.data.email is string)
        && (!('note' in request.resource.data) || request.resource.data.note == null || request.resource.data.note is string);

      allow delete: if belongsToSameHouse(resource.data.casaId);
    }

    // ==========================================
    // DEFAULT DENY
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

